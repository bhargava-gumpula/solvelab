# Cloudflare Pages response headers. scripts/serve-static.mjs applies this file
# too, so the e2e suite runs under the same policy as the live site.
#
# CSP notes: Next's static export bootstraps with inline scripts ('unsafe-inline');
# cubing.js's solver uses new Function and WebAssembly ('unsafe-eval',
# 'wasm-unsafe-eval') in a module worker. connect-src allows any https: origin
# because the AI coach talks to the provider the person picks, including any
# OpenAI-compatible URL they type, and Ollama on localhost. No
# upgrade-insecure-requests: it would turn that local Ollama call into https.
# A rollback to the Firebase account backend would also need
# script-src https://apis.google.com and frame-src https://<authDomain> for its
# redirect helper; the Supabase build never loads Firebase.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' https: wss://*.supabase.co http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), bluetooth=(self)

# Content-hashed build files never change under the same name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/cubing/chunks/*
  Cache-Control: public, max-age=31536000, immutable
