# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
/.next/
/out/
/dist/
next-env.d.ts
*.tsbuildinfo

# generated by scripts/bundle-cubing.mjs
/public/vendor/

# testing
/coverage
/playwright-report/
/test-results/
/review-screenshots/

# ---------------------------------------------------------------------------
# Personal data and secrets. This repository is public: never commit these.
# ---------------------------------------------------------------------------

# Environment files: Firebase web config (.env.local), Pi deploy details (.env.deploy)
.env*

# Keys and credentials (Firebase admin / service accounts, certificates)
*.pem
*.key
*.p12
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
/secrets/

# Exported training data and backups of someone's solves
/ml/exports/
/ml/data/
solvelab-backup-*.json
speedcubing-local-backup*.json

# Firebase CLI state and logs
.firebase/
.firebaserc
firebase-debug.log*
firestore-debug.log*

# Local tool and editor state (AI assistants, IDEs)
/.claude/
/.cursor/
/.aside/
/.agents/
/.codex/
/.vscode/
/.idea/

# logs and OS files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db

# other hosting tools
.vercel
/.wrangler/
/.vinext/
/.sites-runtime/
/outputs/
/work/
