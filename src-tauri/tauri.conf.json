{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SolveLab",
  "version": "6.0.0",
  "identifier": "com.bhargavagumpula.solvelab",
  "build": {
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SolveLab",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://lh3.googleusercontent.com",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:11434 https://lvmipahpadikgftmsjak.supabase.co wss://lvmipahpadikgftmsjak.supabase.co",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["solvelab"]
      }
    },
    "updater": {
      "_comment": "pubkey: OWNER_ADDS_PUBLIC_KEY is a placeholder. The owner replaces it with the one line in their updater .key.pub file (public, safe to commit), made with `npx tauri signer generate` on their own Mac. See docs/MAC_APP_RELEASE.md. Until then every update fails its signature check and the release workflow refuses to build.",
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1RUZFRjlEMUIxRjFGN0YKUldSL0h4OGJuZS92NVd6U09ReHVvdFAzbnk5Ulc2bmswc25sQnJNa2FtOWZ0WGoycXVZMDlkVHIK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/bhargava-gumpula/solvelab/releases/latest/download/latest.json"
      ]
    }
  }
}
