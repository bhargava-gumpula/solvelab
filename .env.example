# Account service. Pick ONE. Everything below is public by design (it ships in
# the site's JavaScript); access is restricted by authorised domains and row
# level security, never by these values. Keep secret keys (Supabase secret key,
# Firebase admin key, Google client secret) out of this file and the repository.

# Supabase (docs/SUPABASE_MIGRATION.md). Dashboard → Project settings → API.
# The key is the publishable key (sb_publishable_…); the legacy anon JWT works
# too but is deprecated by the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Firebase (the service before the move). Firebase console → Project settings
# → General → Your apps → the web app → SDK setup and configuration → Config.
# Used only when the Supabase variables above are empty.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: the Google OAuth web client for the Firebase path's own redirect.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
