{
  "name": "solvelab",
  "version": "5.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "vendor": "node scripts/bundle-cubing.mjs",
    "predev": "npm run vendor",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 5173",
    "dev:supabase": "sh -c 'set -a; . ./.env.supabase.local; set +a; exec next dev --webpack --hostname 127.0.0.1 --port 5174'",
    "prebuild": "npm run vendor",
    "build": "next build --webpack",
    "build:supabase": "sh -c 'set -a; . ./.env.supabase.local; set +a; exec next build --webpack'",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:app": "node scripts/desktop-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "ml:train": "node ml/scripts/train-coach.mjs",
    "ml:f2l": "node ml/scripts/run.mjs ml/build-f2l.ts",
    "ml:coll": "node ml/scripts/run.mjs ml/build-coll.ts",
    "ml:wv": "node ml/scripts/run.mjs ml/build-wv.ts",
    "ml:export": "node ml/scripts/run.mjs ml/train/export-contributions.ts",
    "migrate:export": "node ml/scripts/run.mjs scripts/migrate/export-firestore.ts",
    "migrate:import": "node ml/scripts/run.mjs scripts/migrate/import-supabase.ts",
    "supabase:smoke": "sh -c 'set -a; . ./.env.supabase.local; set +a; exec node ml/scripts/run.mjs scripts/supabase-smoke.ts'",
    "ml:calibrate": "node ml/scripts/run.mjs ml/train/calibrate.ts",
    "ml:sample": "node ml/scripts/run.mjs ml/train/sample-cuber.ts"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@paper-design/shaders-react": "^0.0.80",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "2.117.2",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cubing": "^0.63.4",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "0.170.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.169.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^14.4.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
